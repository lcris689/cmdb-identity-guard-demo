    "start:vinext": "npm run start",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.3.3",
    "drizzle-orm": "0.45.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module"
}
