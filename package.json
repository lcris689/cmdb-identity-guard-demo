{
  "name": "cmdb-identity-guard-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "vite preview",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .cloudflare",
    "db:generate": "drizzle-kit generate",
