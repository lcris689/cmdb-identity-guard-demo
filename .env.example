# Use the included same-origin backend proxy in production. Do not put ServiceNow credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_IDENTITY_GUARD_API_BASE=/api/identity-guard
# Keep true for safe demo fallback. Set false to use live ServiceNow API routes.
NEXT_PUBLIC_IDENTITY_GUARD_USE_MOCKS=true
# Keep true for a no-login, no-network portfolio demo that uses synthetic records.
NEXT_PUBLIC_IDENTITY_GUARD_OFFLINE_DEMO=true

# Server-side demo access. Choose your own values and configure them as deployment secrets.
DEMO_ACCESS_USERNAME=steward
DEMO_ACCESS_PASSWORD=replace-with-a-demo-password
# Use a randomly generated value containing at least 32 characters.
DEMO_SESSION_SECRET=replace-with-a-random-32-character-minimum-secret

# Server-side only. Do not prefix these with NEXT_PUBLIC_ and do not commit .env.local.
SERVICENOW_INSTANCE_URL=https://YOUR_INSTANCE.service-now.com
SERVICENOW_IDENTITY_GUARD_PATH=/api/x_kest_data_sort/data_sorters_identity_guard_api
# Use either bearer token or username/password for the proxy's server-side ServiceNow request.
SERVICENOW_BEARER_TOKEN=
SERVICENOW_USERNAME=data.sorters.api
SERVICENOW_PASSWORD=
